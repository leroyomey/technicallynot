{
  "name": "tnai",
  "productName": "TechnicallyNot.ai",
  "version": "0.3.76",
  "tnaiBuild": 82,
  "tnaiPublicRepo": "",
  "tnaiAccountsUrl": "",
  "description": "Technically Not: a free, open-source visual AI software-building workspace (Windows desktop app).",
  "license": "MIT",
  "homepage": "https://github.com/leroyomey/technicallynot",
  "author": {
    "name": "Technically Not LLC",
    "email": "support@technicallynot.ai"
  },
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "format": "node tools/format-code.js",
    "format:check": "node tools/format-code.js --check",
    "start": "electron .",
    "check": "node tools/check-syntax.js",
    "predist": "node tools/prebuild.js",
    "dist": "electron-builder --win nsis --publish never",
    "check-package": "node tools/check-package.js"
  },
  "build": {
    "appId": "ai.technicallynot.desktop",
    "copyright": "Copyright © 2026 Technically Not LLC",
    "productName": "TechnicallyNot.ai",
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.png",
    "files": [
      "index.html",
      "src/**",
      "desktop/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build-resources/auth-config.json",
        "to": "auth-config.json"
      },
      {
        "from": "build-resources/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "build-resources/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "node_modules/node-pty/**/*.{node,dll,exe}",
      "node_modules/node-pty/**/spawn-helper"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build-resources/node/${os}-${arch}",
          "to": "node"
        }
      ]
    },
    "nsis": {
      "guid": "dc5455a9-a469-5449-ba84-cc0e007d4215",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "TechnicallyNot.ai",
      "uninstallDisplayName": "TechnicallyNot.ai"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-mac-${arch}-${version}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "signIgnore": [
        "Contents/Resources/node/node$"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Technically Not uses the microphone only while you hold the voice prompt button, to turn your speech into prompt text on this Mac."
      },
      "extraResources": [
        {
          "from": "build-resources/whisper/${os}-${arch}",
          "to": "whisper"
        },
        {
          "from": "build-resources/node/${os}-${arch}",
          "to": "node"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "executableName": "technicallynot",
      "maintainer": "Technically Not <support@technicallynot.ai>",
      "vendor": "Technically Not LLC",
      "synopsis": "Open-source visual AI software-building workspace",
      "description": "Technically Not: a free, open-source (MIT) visual AI software-building workspace with agent threads, files and live preview.",
      "artifactName": "${productName}-linux-${arch}-${version}.${ext}",
      "extraResources": [
        {
          "from": "build-resources/whisper/${os}-${arch}",
          "to": "whisper"
        },
        {
          "from": "build-resources/node/${os}-${arch}",
          "to": "node"
        },
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "npmRebuild": false,
    "extraMetadata": {
      "tnaiRelease": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/tnai"
      }
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "prettier": "3.9.10"
  },
  "overrides": {
    "http-cache-semantics": "^4.3.0",
    "global-agent": "^4.1.3"
  }
}
